  "cases": [
    {
      "id": "L01",
      "kind": "excerpt",
      "category": "新研究文章限定",
      "stratum": "known_topic_or_audit_regression",
      "question": "Lean kernel 能验证证明后，作者为何仍要 manually audit the theorem statements？请摘录原文。",
      "sources": [
        "audit"
      ],
      "expected_points": [
        "机器检查证明不代替人工检查定理是否对应正确的程序性质；引用文章，不宣称所有代码无缺陷。"
      ],
      "requires_citations": true,
      "required_patterns": [
        "theorem"
      ]
    },
    {
      "id": "L02",
      "kind": "excerpt",
      "category": "新研究文章覆盖范围",
      "stratum": "known_topic_or_audit_regression",
      "question": "这篇文章的 decompiler 是否覆盖 all MASM procedures？请保留 subset 的限定。",
      "sources": [
        "audit"
      ],
      "expected_points": [
        "作者不能兼顾正确性而反编译全部程序，因此覆盖明确定义的子集；不外推全部MASM。"
      ],
      "requires_citations": true,
      "required_patterns": [
        "subset|all MASM"
      ]
    },
    {
      "id": "L03",
      "kind": "excerpt",
      "category": "新论文摘要范围",
      "stratum": "known_topic_or_audit_regression",
      "question": "只根据这份论文摘要，摘录 rule files 与 attacker-controlled packages 的风险条件；摘要没给数字就不要编造成功率。",
      "sources": [
        "abstract"
      ],
      "expected_points": [
        "恶意提示植入规则文件、诱导编码智能体替换依赖；这是摘要陈述。",
        "不得宣称已经获取论文全文或本项目复现了攻击，也不编造具体成功率。"
      ],
      "requires_citations": true,
      "required_patterns": [
        "摘要",
        "rule files|attacker-controlled"
      ]
    },
    {
      "id": "L04",
      "kind": "excerpt",
      "category": "目录与正文",
      "stratum": "known_topic_or_audit_regression",
      "question": "GB/T 45654-2025 在这里有技术条款全文吗？能否仅凭该记录断言我们已满足技术要求？",
