# Optional credentials; enter real values locally in .env, never commit them.
NVD_API_KEY=
GITHUB_TOKEN=

# Path to B SQLite (API + monitor). Default: intelligence/data/intelligence.db
# Offline demo without network collection:
#   python seed_demo_db.py --force
#   INTELLIGENCE_DB_PATH=data/intelligence.db python run_intelligence_api_v6.py
INTELLIGENCE_DB_PATH=

# run_monitor.py polls all 11 sources / 8 categories every 15 minutes.
MONITOR_INTERVAL_MINUTES=15
MONITOR_WORKERS=4
SOURCE_TIMEOUT_SECONDS=120
RECENT_LOOKBACK_HOURS=12
RECENT_MAX_PAGES=4
BACKFILL_MAX_PAGES=4
BACKFILL_MAX_WINDOWS=1
BACKFILL_WINDOW_HOURS=1
VULNERABILITY_BOOTSTRAP_DAYS=7
PAPER_LOOKBACK_DAYS=7
# Optional JSON source catalog; empty selects the built-in eight categories.
INTELLIGENCE_SOURCE_CONFIG=

INCREMENTAL_OVERLAP_MINUTES=30
INCREMENTAL_SETTLE_MINUTES=5
INCREMENTAL_WINDOW_DAYS=7
# The following limits apply only to the legacy three-source entry point.
INCREMENTAL_MAX_WINDOWS=8
NVD_BOOTSTRAP_DAYS=7
GITHUB_BOOTSTRAP_DAYS=7
NVD_MAX_PAGES=30
GITHUB_MAX_PAGES=30
MONITOR_TIMEOUT_SECONDS=900

# Classify after each collection cycle; zero model calls by default.
AUTO_CLASSIFY_V5=1
CLASSIFY_V5_MAX_ITEMS=300
CLASSIFY_V5_MAX_LLM_CALLS=0
LLM_API_BASE=
LLM_CHAT_COMPLETIONS_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
