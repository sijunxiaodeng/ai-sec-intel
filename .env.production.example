# Copy to .env.production, keep local, and restrict file permissions (chmod 600).
# Required only for docker-compose.actions.yml: repository Actions read access.
# Fine-grained GitHub token: this repository, Actions: read, Metadata: read.
GITHUB_TOKEN=

# Optional Actions push receiver. Use >=16 random characters on the deploy.
# Set the same value securely as the GitHub DEPLOY_INGEST_TOKEN secret;
# DEPLOY_INGEST_URL is the deploy's public HTTPS base URL or actions-sync URL.
# production-up.sh loads this file for Compose interpolation, and injects this
# token only into main-app. Keep blank to leave the ingest endpoint disabled.
ACTIONS_INGEST_TOKEN=

# Optional docker-compose.observability.yml overlay only. Set a unique local
# Grafana admin password; do not put a real password in this example or chat.
GRAFANA_ADMIN_PASSWORD=

# Optional for the always-online collector mode.
NVD_API_KEY=

# Optional local BGE runtime. Rebuild main-app after setting to 1, then prepare
# real data explicitly: python -m rag.prepare --semantic --db /app/data/task_c.sqlite3
# Repeat for /app/data/library.sqlite3. Omit --demo for production databases.
INSTALL_SEMANTIC=0

# Opt in to bounded LLM tool selection using the saved main-app model settings.
# Otherwise evidence-gap planning uses deterministic rules. At most two small
# model responses per investigation; no model-generated URLs or shell commands.
INVESTIGATION_USE_MODEL=0

# Model review is optional; never required for source collection.
# Configure any paid-provider key through deployment secrets, not source code.
