# Copy to .env.production, keep local, and restrict file permissions (chmod 600).
# Required only for docker-compose.actions.yml: repository Actions read access.
# Fine-grained GitHub token: this repository, Actions: read, Metadata: read.
GITHUB_TOKEN=

# Optional for the always-online collector mode.
NVD_API_KEY=

# Model review is optional; never required for source collection.
# Configure any paid-provider key through deployment secrets, not source code.
